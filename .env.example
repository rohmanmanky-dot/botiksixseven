# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID группового чата (можно не заполнять: отправьте /here в чате от имени старосты)
CHAT_ID=

# Telegram ID старост/админов через запятую (узнать: /whoami)
ADMIN_IDS=

# Часовой пояс
TIMEZONE=Europe/Moscow

# За сколько минут напоминать (можно переопределить для пары в расписании)
REMIND_BEFORE_MINUTES=30

# Утренний дайджест с расписанием на день (HH:MM, пусто — выключено)
DIGEST_AT=08:00

# Через сколько минут после начала пары подводить итог переклички
SUMMARY_AFTER_MINUTES=10

# Пути к файлам
SCHEDULE_PATH=config/schedule.json
ROSTER_PATH=config/roster.json
DB_PATH=data/bot.sqlite3
